# Deployment identity for the asmdb platform and the Fabric workload.
#
# Copy this file to deploy.env in the repository root and fill in the values for
# your own directory and subscription. deploy.env is gitignored: it names a
# specific tenant, a specific subscription and specific Entra objects, and none
# of that belongs in a public repository even though none of it is a secret.
#
# The deployment scripts refuse to run without it rather than falling back to a
# default. A default subscription id is the kind of convenience that eventually
# deploys somebody's infrastructure into the wrong account.
#
# None of these values is a credential. The console signs in with
# authorization-code and PKCE, so there is no client secret anywhere; these are
# identifiers, and they are externalised because they identify an environment,
# not because they unlock one.

# --- Azure ----------------------------------------------------------------
# az account show --query tenantId -o tsv
ASMDB_TENANT_ID=00000000-0000-0000-0000-000000000000
# az account show --query id -o tsv
ASMDB_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# Resource group holding the platform: control plane, APIM, ACR, instances.
ASMDB_RESOURCE_GROUP=asmdb-platform
# Container registry name: a globally unique DNS label, so it identifies you.
ASMDB_ACR_NAME=asmdbacr00000000
ASMDB_LOCATION=swedencentral

# --- asmdb Cloud console sign-in ------------------------------------------
# The Entra application the browser console authenticates against, and the
# security group whose members may provision databases.
ASMDB_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ASMDB_ENTRA_GROUP_ID=00000000-0000-0000-0000-000000000000

# Public hostname of the console. Must already resolve by CNAME to the gateway
# before deployment: the managed certificate is only issued once the record is
# visible from the internet.
ASMDB_CUSTOM_DOMAIN=www.example.com

# --- Fabric workload ------------------------------------------------------
# Separate from the console application above, and deliberately so: the
# workload is a multitenant SPA registered against a verified custom domain.
ASMDB_WORKLOAD_APP_ID=00000000-0000-0000-0000-000000000000
# Resource group for the workload's own backend and frontend. Kept apart from
# the platform group so a workload deployment cannot touch the live service.
ASMDB_WORKLOAD_RESOURCE_GROUP=asmdb-analytics
# The verified custom domain the workload's frontend and App ID URI derive from.
ASMDB_WORKLOAD_DOMAIN=example.com
