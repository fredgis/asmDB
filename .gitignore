# Build output. Everything under build/ is generated by scripts/build.ps1 or
# scripts/build.sh — nothing in there is source, so ignore the directory rather
# than chasing each new artefact extension a test run leaves behind.
#
# Anchored to the repository root: an unanchored "build/" also swallowed
# workload/build/, which is source (the packaging scripts), not output.
/build/

# Compiled Go binaries. `go build` in a module directory drops an executable
# named after it; two of these (9.7 MB and 12 MB) reached a commit before this
# rule existed.
*.exe
!build/*.exe

*.dat
*.wal
*.cdc
*.bak

# Editor / OS
*.swp
Thumbs.db

# Node (MCP server)
node_modules/
npm-debug.log*

# Python bytecode
__pycache__/
*.pyc

# Local configuration. .env may hold an Entra client secret in the
# development credential mode; keep only the .example files in git.
.env
.env.*
!.env.example

# Build output (workload backend/frontend, packaged workload)
workload/*/dist/
workload/build/out/
*.nupkg
