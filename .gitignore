# Build output. Everything under build/ is generated by scripts/build.ps1 or
# scripts/build.sh — nothing in there is source, so ignore the directory rather
# than chasing each new artefact extension a test run leaves behind.
build/

# Runtime data files
*.dat
*.wal
*.cdc
*.bak

# Editor / OS
*.swp
Thumbs.db

# Node (MCP server)
node_modules/
npm-debug.log*

# Python bytecode
__pycache__/
*.pyc
