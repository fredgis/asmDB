PORT=5010
ASMDB_WL_ENTRA_TENANT_ID=<tenant-id>
ASMDB_WL_ENTRA_CLIENT_ID=<workload-app-client-id>

# Preferred in Azure: no secret. Configure a federated identity credential on
# the workload app registration and run this backend with a managed identity.
ASMDB_WL_USE_MANAGED_IDENTITY=true
# Optional for user-assigned managed identity; omit for system-assigned.
# ASMDB_WL_MANAGED_IDENTITY_CLIENT_ID=<managed-identity-client-id>

# Local-development fallback only. In Azure, if this fallback is unavoidable,
# populate it from a Key Vault secret reference, never as a literal value.
# ASMDB_WL_ENTRA_CLIENT_SECRET=<key-vault-reference-or-local-dev-secret>

ASMDB_CLOUD_API=https://www.asmdb.cloud/api/v1
# Optional when the cloud /config endpoint is not reachable anonymously.
# ASMDB_CLOUD_SCOPE=api://<asmdb-cloud-app-id>/.default
ASMDB_GATEWAY_URL=https://<cdc-gateway-host>
ASMDB_GATEWAY_TOKEN=<gateway-shared-token>
